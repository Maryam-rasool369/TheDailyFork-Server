// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for different model

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
}

enum BlogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique // e.g. "USER", "ADMIN"

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int          @id @default(autoincrement())
  firstName    String
  lastName     String?
  email        String       @unique
  password     String?
  googleId     String?      @unique
  authProvider AuthProvider @default(LOCAL)
  profileImage String?
  bio          String?
  gender       Gender?
  birthday     DateTime?
  phoneNumber  String?
  isVerified   Boolean      @default(false)

  isAdmin Boolean @default(false)
  roleId  Int
  role    Role    @relation(fields: [roleId], references: [id])

  blogs                           Blog[]
  blogReads                       BlogRead[]
  blogLikes                       BlogLike[]

  stripeCustomerId                String?    @unique
  pendingMonthlyCheckoutSessionId String?
  pendingYearlyCheckoutSessionId  String?

  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String           @unique
  stripePriceId        String
  status               String
  plan                 SubscriptionPlan

  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ProcessedWebhookEvent {
  id        Int    @id @default(autoincrement())
  eventId   String @unique // Stripe's event.id, e.g. "evt_1UJD8t..."
  eventType String

  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id               Int        @id @default(autoincrement())
  title            String
  shortDescription String
  content          String
  imageUrl         String
  status           BlogStatus @default(PENDING)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  featuredOrder Int? @unique // for admin to set the featured blogs on the home page

  notifiedAt DateTime?

  blogLikes        BlogLike[] //for the likes of the blog

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  blogId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@index([blogId])
}

// Tracks which blogs a free (non-subscribed) logged-in user has already
// "spent" one of their 3 free full reads on. Re-reading a blog already
// in this table doesn't count again.

model BlogRead {
  id     Int @id @default(autoincrement())
  userId Int
  blogId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([userId, blogId]) // applies to a combination of fields and this is Model level attribute
  @@index([userId]) // same as above 
}

// Tokens that were logged out before they expired. authValidation rejects any
// token whose hash is in here. Rows can be deleted once expiresAt has passed.
model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
